{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.lover_fox.move": {
      "initial_state": "stand",
      "states": {
        "stand": {
          "animations": [
            "lover_fox_idle",
            "lover_fox_extra5",
            "lover_fox_blink"
          ],
          "transitions": [
            {
              "attack1": "query.property('quan:attack_phase') == 1"
            },
            {
              "attack2": "query.property('quan:attack_phase') == 2"
            },
            {
              "sleep": "query.property('quan:is_sleeping') == true"
            },
            {
              "sit": "query.property('quan:is_sitting') == true"
            },
            {
              "walk": "query.property('quan:is_moving') == true || query.modified_move_speed > 0.01 || query.ground_speed > 0.03"
            }
          ]
        },
        "walk": {
          "animations": [
            "lover_fox_walk",
            "lover_fox_extra5",
            "lover_fox_blink"
          ],
          "transitions": [
            {
              "attack1": "query.property('quan:attack_phase') == 1"
            },
            {
              "attack2": "query.property('quan:attack_phase') == 2"
            },
            {
              "sleep": "query.property('quan:is_sleeping') == true"
            },
            {
              "sit": "query.property('quan:is_sitting') == true"
            },
            {
              "stand": "query.property('quan:is_moving') != true && query.modified_move_speed <= 0.01 && query.ground_speed <= 0.03"
            }
          ]
        },
        "sit": {
          "animations": [
            "lover_fox_sit",
            "lover_fox_extra5",
            "lover_fox_blink"
          ],
          "transitions": [
            {
              "attack1": "query.property('quan:attack_phase') == 1"
            },
            {
              "attack2": "query.property('quan:attack_phase') == 2"
            },
            {
              "sleep": "query.property('quan:is_sleeping') == true"
            },
            {
              "walk": "query.property('quan:is_moving') == true || query.modified_move_speed > 0.01 || query.ground_speed > 0.03"
            },
            {
              "stand": "query.property('quan:is_sitting') != true"
            }
          ]
        },
        "sleep": {
          "animations": [
            "lover_fox_sleep"
          ],
          "transitions": [
            {
              "stand": "query.property('quan:is_sleeping') != true"
            }
          ]
        },
        "attack1": {
          "animations": [
            "lover_fox_attack_a",
            "lover_fox_extra5",
            "lover_fox_blink"
          ],
          "transitions": [
            {
              "attack2": "query.property('quan:attack_phase') == 2"
            },
            {
              "sleep": "query.property('quan:is_sleeping') == true"
            },
            {
              "sit": "query.property('quan:attack_phase') == 0 && query.property('quan:is_sitting') == true"
            },
            {
              "walk": "query.property('quan:attack_phase') == 0 && (query.property('quan:is_moving') == true || query.modified_move_speed > 0.01 || query.ground_speed > 0.03)"
            },
            {
              "stand": "query.property('quan:attack_phase') == 0"
            }
          ]
        },
        "attack2": {
          "animations": [
            "lover_fox_attack_b",
            "lover_fox_extra5",
            "lover_fox_blink"
          ],
          "transitions": [
            {
              "attack1": "query.property('quan:attack_phase') == 1"
            },
            {
              "sleep": "query.property('quan:is_sleeping') == true"
            },
            {
              "sit": "query.property('quan:attack_phase') == 0 && query.property('quan:is_sitting') == true"
            },
            {
              "walk": "query.property('quan:attack_phase') == 0 && (query.property('quan:is_moving') == true || query.modified_move_speed > 0.01 || query.ground_speed > 0.03)"
            },
            {
              "stand": "query.property('quan:attack_phase') == 0"
            }
          ]
        }
      }
    }
  }
}
